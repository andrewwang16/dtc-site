# Auth.js — generate with `npx auth secret`
AUTH_SECRET=

# Admin login (email + password). Generate each hash locally with
# `node scripts/hash-password.mjs` — paste the resulting hash here,
# never the plain password.
ADMIN_PASSWORD_HASH_AW=
ADMIN_PASSWORD_HASH_JOSHUA=

# Postgres (Vercel dashboard → Storage → add Postgres → auto-injected)
DATABASE_URL=

# Vercel Blob (Vercel dashboard → Storage → add Blob store → auto-injected)
BLOB_READ_WRITE_TOKEN=
