# Auth.js — generate with `npx auth secret`
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres (Vercel dashboard → Storage → add Postgres → auto-injected)
DATABASE_URL=

# Vercel Blob (Vercel dashboard → Storage → add Blob store → auto-injected)
BLOB_READ_WRITE_TOKEN=
