# Auth.js — generate with `npx auth secret`
AUTH_SECRET=

# Postgres (Vercel dashboard → Storage → add Postgres → auto-injected;
# the code checks POSTGRES_URL first, then DATABASE_URL, so either
# integration's naming works)
POSTGRES_URL=

# No password env vars needed — accounts (including the two admins)
# live in the `users` table. Run scripts/create-admin.mjs once per
# admin, and anyone can create a viewer account via /sign-up.

# YouTube Data API v3 key — used to pull descriptions from the Dealin'
# the Cards / Birds on the Farm playlists for the player-page "Podcast
# Mentions" section (playlist scraping alone doesn't expose descriptions).
# Get one free: Google Cloud Console → new/existing project → APIs &
# Services → Library → enable "YouTube Data API v3" → Credentials →
# Create Credentials → API key.
YOUTUBE_API_KEY=
